# .env.example
# Kiosk Frontend Environment Configuration Template
# Copy this to .env and fill in real values

# ============================================
# API CONNECTION
# ============================================
# Local development: http://localhost:8000
# Docker backend: http://localhost:8001
# Production: https://kiosk.yourdomain.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================
# MEDIA STORAGE CONFIGURATION
# ============================================

# Storage Provider: local | s3
# - local: Load media from local filesystem or backend server
# - s3: Load media from S3-compatible storage (AWS S3, MinIO, DigitalOcean Spaces, Selectel)
VITE_STORAGE_PROVIDER=local

# ============================================
# LOCAL STORAGE CONFIGURATION
# Used when VITE_STORAGE_PROVIDER=local
# ============================================

# Base path for media
# Note: file:// URLs don't work in browsers due to security restrictions
# Use backend HTTP URL instead (backend serves files from MEDIA_PATH)
#
# Examples:
# - Local backend: http://localhost:8000/media
# - Docker backend: http://localhost:8001/media
# - Production: https://kiosk.yourdomain.com/media
VITE_LOCAL_MEDIA_BASE_PATH=http://localhost:8000/media

# Path patterns for each media type (relative to base path)
# These should match the folder structure in /var/kiosk/media
VITE_LOCAL_PATH_ITEMS=/items
VITE_LOCAL_PATH_CATEGORIES_OPEN=/categories/categories_open_poster
VITE_LOCAL_PATH_CATEGORIES_SORRY=/categories/categories_sorry_poster
VITE_LOCAL_PATH_CATEGORIES_PROMOTED=/categories/categories_promoted_poster
VITE_LOCAL_PATH_SCREENSAVER=/screensaver
VITE_LOCAL_PATH_ORDER_HANDLING=/order_handling
VITE_LOCAL_PATH_SERVICE_MODE=/service_mode


# ============================================
# S3 STORAGE CONFIGURATION
# Used when VITE_STORAGE_PROVIDER=s3
# ============================================

# S3 public CDN endpoint for bucket
# Format for Selectel: https://{container-id}.selstorage.ru
# Format for AWS S3: https://{bucket-name}.s3.{region}.amazonaws.com
# Format for DigitalOcean: https://{bucket-name}.{region}.digitaloceanspaces.com
VITE_S3_ENDPOINT=https://YOUR_CONTAINER_ID.selstorage.ru

# S3 Credentials (ONLY needed for private buckets or backend uploads)
# For public buckets with CDN URL, these can be left empty
# SECURITY WARNING: These will be exposed in browser JavaScript!
# For production, use public bucket or backend-signed URLs instead
VITE_S3_REGION=ru-7
VITE_S3_BUCKET=your-bucket-name
VITE_S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
VITE_S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
VITE_S3_USE_SSL=true

# Path patterns for each media type (folders within S3 bucket)
VITE_S3_PATH_ITEMS=/items
VITE_S3_PATH_CATEGORIES_OPEN=/categories_open_poster
VITE_S3_PATH_CATEGORIES_SORRY=/categories_sorry_poster
VITE_S3_PATH_CATEGORIES_PROMOTED=/categories_promoted_poster
VITE_S3_PATH_SCREENSAVER=/screensaver
VITE_S3_PATH_ORDER_HANDLING=/order_handling
VITE_S3_PATH_SERVICE_MODE=/service_mode

# Named media lists (comma-separated, extensionless, case-sensitive)
VITE_SERVICE_MODE_MEDIA_NAMES=main,maintenance,dayoff
VITE_SCREENSAVER_MEDIA_NAMES=screensaver
VITE_ORDER_HANDLING_MEDIA_NAMES=order_handling